{
  "contract_version": "1.0.0",
  "module_key": "mfe-example-chat",
  "module_version": "0.1.0",
  "kind": "mfe",
  "display_name": "MFE Example Chat (GraphQL Stream)",
  "description": "Example MFE chat input that submits prompt over GraphQL mutation and receives response over GraphQL stream subscription.",
  "targets": ["web"],
  "execution": {
    "mode": "inline",
    "preload": "lazy",
    "entry": {
      "web_package": "dist/example-mfe.js",
      "export_name": "createModule"
    }
  },
  "io": {
    "slots_in": ["main"],
    "slots_out": [],
    "props_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "title": "Title"
        },
        "inputPlaceholder": {
          "type": "string",
          "title": "Input Placeholder"
        },
        "submitLabel": {
          "type": "string",
          "title": "Submit Label"
        },
        "assistantLabel": {
          "type": "string",
          "title": "Assistant Label"
        },
        "maxMessages": {
          "type": "integer",
          "title": "Max Messages",
          "minimum": 1,
          "maximum": 200
        },
        "requestCommand": {
          "type": "string",
          "title": "Request Command"
        },
        "graphql": {
          "type": "object",
          "title": "GraphQL Transport",
          "additionalProperties": false,
          "properties": {
            "httpUrl": {
              "type": "string",
              "title": "GraphQL HTTP URL"
            },
            "wsUrl": {
              "type": "string",
              "title": "GraphQL WS URL"
            },
            "authToken": {
              "type": "string",
              "title": "Auth Token"
            },
            "submitMutation": {
              "type": "string",
              "title": "Submit Mutation"
            },
            "submitVariables": {
              "type": "object",
              "title": "Submit Variables Template",
              "additionalProperties": true
            },
            "submitRequestIdPath": {
              "type": "string",
              "title": "Submit Request Id Path"
            },
            "streamSubscription": {
              "type": "string",
              "title": "Stream Subscription"
            },
            "streamVariables": {
              "type": "object",
              "title": "Stream Variables Template",
              "additionalProperties": true
            },
            "streamTextPath": {
              "type": "string",
              "title": "Stream Text Path"
            },
            "streamDonePath": {
              "type": "string",
              "title": "Stream Done Path"
            },
            "streamErrorPath": {
              "type": "string",
              "title": "Stream Error Path"
            },
            "streamChunkMode": {
              "type": "string",
              "title": "Stream Chunk Mode",
              "enum": ["append", "replace"]
            },
            "conversationId": {
              "type": "string",
              "title": "Conversation Id"
            }
          },
          "required": [
            "httpUrl",
            "wsUrl",
            "submitMutation",
            "submitRequestIdPath",
            "streamSubscription",
            "streamTextPath",
            "streamDonePath"
          ]
        }
      },
      "required": ["graphql"]
    },
    "events_out": [
      {
        "name": "mfe.example.chat.submitted",
        "payload_schema": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "mode": {
              "type": "string"
            }
          },
          "required": ["text"]
        },
        "async_allowed": true
      },
      {
        "name": "mfe.example.chat.responded",
        "payload_schema": {
          "type": "object",
          "properties": {
            "requestId": {
              "type": "string"
            },
            "source": {
              "type": "string"
            }
          },
          "required": ["source"]
        },
        "async_allowed": true
      }
    ],
    "commands_in": [
      {
        "name": "mfe.example.chat.send",
        "input_schema": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            }
          },
          "required": ["text"]
        },
        "timeout_ms": 60000
      }
    ]
  },
  "async": {
    "enabled": true,
    "mode": "mixed",
    "request": {
      "supported": true,
      "default_timeout_ms": 30000,
      "retry": {
        "max_attempts": 2,
        "initial_backoff_ms": 250,
        "max_backoff_ms": 2000,
        "jitter": true
      }
    },
    "stream": {
      "supported": true,
      "transport": "graphql-ws",
      "endpoint_ref": "GRAPHQL_STREAM_ENDPOINT",
      "auth_mode": "inherit",
      "reconnect": {
        "max_attempts": 10,
        "initial_backoff_ms": 500,
        "max_backoff_ms": 10000,
        "jitter": true
      }
    },
    "queue": {
      "supported": true,
      "max_inflight": 64,
      "drop_policy": "backpressure",
      "ordering_key": "instance_id"
    }
  },
  "capabilities": {
    "network": true,
    "storage": false,
    "navigation": false,
    "sensors": false,
    "notifications": false,
    "background_tasks": false
  },
  "lifecycle": {
    "hooks": ["init", "mount", "update", "handleCommand", "unmount"],
    "supports_hydration": true,
    "supports_suspend": false
  },
  "compatibility": {
    "min_host_contract_version": "1.0.0",
    "breaking_change_policy": "semver-major"
  }
}
